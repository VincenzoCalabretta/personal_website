# site/BUILD.bazel
#
# Build the Zola site and deploy it to a VPS.
#
# Commands:
#   bazel build //site:site      → builds into bazel-bin/site/site_public/
#   bazel run   //site:deploy    → builds + rsyncs to your VPS

load("//rules:zola.bzl", "zola_site")
load("//rules:deploy.bzl", "deploy")

zola_site(
    name = "site",
    config = "config.toml",
    srcs = glob(
        [
            "config.toml",
            "content/**",
            "templates/**",
        ],
        exclude = [
            "templates/resume.html",  # sourced from //cv-upstream via overlays
            "**/.DS_Store",
            "**/*.swp",
            "**/.*",
        ],
    ) + glob(
        ["static/**"],
        allow_empty = True,
        exclude = [
            "static/resume.css",    # sourced from //cv-upstream via overlays
            "static/fonts/**",      # sourced from //cv-upstream via overlays
            "static/images/**",     # sourced from //cv-upstream via overlays
            "**/.gitkeep",
        ],
    ) + glob(
        ["sass/**"],
        allow_empty = True,
        exclude = ["**/.gitkeep"],
    ) + glob(
        ["themes/**"],
        allow_empty = True,
        exclude = ["**/.gitkeep"],
    ),
    overlays = {
        "//cv-upstream:resume_json":     "resume.json",
        "//cv-upstream:resume_template": "templates/resume.html",
        "//cv-upstream:resume_css":      "static/resume.css",
        "//cv-upstream:fonts":           "static/fonts/",
        "//cv-upstream:images":          "static/images/",
    },
)

deploy(
    name = "deploy",
    site = ":site",
    remote_user = "deploy",
    remote_host = "your-vps.example.com",  # ← change this
    remote_path = "/var/www/mysite",        # ← change this
    # ssh_key = "/home/you/.ssh/id_ed25519",  # optional
)
